<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UnderwaterHorrors</RootNamespace>
    <AssemblyName>UnderwaterHorrors</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(APPDATA)\Vintagestory\VintagestoryAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(APPDATA)\Vintagestory\VintagestoryLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(APPDATA)\Vintagestory\Mods\VSSurvivalMod.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(APPDATA)\Vintagestory\Mods\VSEssentials.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(APPDATA)\Vintagestory\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(APPDATA)\Vintagestory\Lib\protobuf-net.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="Package" AfterTargets="PostBuildEvent">
    <!-- Extract the mod version from modinfo.json so the output zip has it baked in -->
    <PropertyGroup>
      <ModInfoContent>$([System.IO.File]::ReadAllText('$(ProjectDir)modinfo.json'))</ModInfoContent>
      <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($(ModInfoContent), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModVersion>
      <ZipName>UnderwaterHorrors_$(ModVersion).zip</ZipName>
    </PropertyGroup>

    <ItemGroup>
      <PackageFiles Include="$(TargetPath)" />
      <PackageFiles Include="modinfo.json" />
      <AssetFiles Include="assets\**\*" />
      <!-- Clean up older versioned zips so only the current one is deployed -->
      <OldZipsBin Include="$(ProjectDir)bin\$(Configuration)\$(TargetFramework)\UnderwaterHorrors*.zip" />
      <OldZipsDeploy Include="$(APPDATA)\VintagestoryData\Mods\UnderwaterHorrors*.zip" />
      <!--
        VS hashes the zip contents into a unique unpack-cache directory
        name. Each `dotnet build` produces a new zip with the same name
        but different hash, leaving the previous unpack cache directory
        behind with its own UnderwaterHorrors.dll. On next game launch
        VS would try to load BOTH dlls, hit "Assembly with same name
        already loaded" and skip the mod. Wipe stale cache dirs every
        build so only the freshly-deployed zip is ever unpacked.
      -->
      <StaleUnpackCache
        Include="$([System.IO.Directory]::GetDirectories('$(APPDATA)\VintagestoryData\Cache\unpack', 'UnderwaterHorrors*'))"
        Condition="Exists('$(APPDATA)\VintagestoryData\Cache\unpack')" />
    </ItemGroup>

    <!--
      Order matters. The game locks the unpack-cache DLL while running, so the
      RemoveDir below can fail. If we did the destructive cleanup FIRST (as this
      target used to), a failed RemoveDir aborted the whole target AFTER the
      deployed zip had already been deleted, leaving no mod deployed at all.

      Instead: (1) clean local bin zips (never locked) and build the new zip
      first, so a good artifact always exists in bin\; (2) do the destructive
      cleanup of deployed/cached files best-effort with ContinueOnError so a
      running game can't abort the build; (3) deploy the freshly built zip last.
    -->

    <!-- 1. Clean old bin zips (bin is never locked) and build the new zip -->
    <Delete Files="@(OldZipsBin)" />
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(ProjectDir)bin\$(Configuration)\$(TargetFramework)\mod\" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(ProjectDir)bin\$(Configuration)\$(TargetFramework)\mod\%(Identity)')" />
    <ZipDirectory SourceDirectory="$(ProjectDir)bin\$(Configuration)\$(TargetFramework)\mod\" DestinationFile="$(ProjectDir)bin\$(Configuration)\$(TargetFramework)\$(ZipName)" Overwrite="true" />

    <!-- 2. Best-effort cleanup of deployed/cached artifacts (may be locked) -->
    <Delete Files="@(OldZipsDeploy)" ContinueOnError="true" />
    <RemoveDir Directories="@(StaleUnpackCache)" ContinueOnError="true" />

    <!-- 3. Deploy the freshly built zip last -->
    <Copy SourceFiles="$(ProjectDir)bin\$(Configuration)\$(TargetFramework)\$(ZipName)" DestinationFolder="$(APPDATA)\VintagestoryData\Mods\" />
    <Message Importance="high" Text="Deployed $(ZipName) to $(APPDATA)\VintagestoryData\Mods\" />
  </Target>

</Project>
