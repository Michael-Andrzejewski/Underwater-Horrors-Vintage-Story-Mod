<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GamePath Condition="'$(GamePath)' == ''">$(APPDATA)\Vintagestory</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\src\Helpers\AnglerfishAttackCycle.cs" Link="AnglerfishAttackCycle.cs" />
    <Compile Include="..\..\..\src\Helpers\AnglerfishLureCycle.cs" Link="AnglerfishLureCycle.cs" />
    <Reference Include="VintagestoryAPI"><HintPath>$(GamePath)\VintagestoryAPI.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GamePath)\Lib\Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>
